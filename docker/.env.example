# =============================================================================
# Readest self-hosted configuration
# Copy to docker/.env and edit before: docker compose up -d
# Full documentation: ../docker-compose.yml (header) and docker/README.md
# =============================================================================

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
HOST_IP=localhost
CLIENT_HTTP_PORT=3000
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
# SUPABASE_PUBLIC_URL=https://your-domain.com
# S3_PUBLIC_ENDPOINT=https://your-domain.com
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:8000/**
# PROTOCOL=https
# HOST=your-domain.com

READEST_IMAGE=ghcr.io/readest/readest:latest

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# -----------------------------------------------------------------------------
# JWT / Supabase API keys (required)
# Generate ANON_KEY and SERVICE_ROLE_KEY as HS256 JWTs signed with JWT_SECRET:
#   anon payload:          {"role":"anon"}
#   service_role payload:  {"role":"service_role"}
# Tools: https://jwt.io
# -----------------------------------------------------------------------------
JWT_EXPIRY=3600
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
ANON_KEY=your-anon-key-jwt-signed-with-jwt-secret
SERVICE_ROLE_KEY=your-service-role-key-jwt-signed-with-jwt-secret
KONG_HTTP_PORT=8000
PGRST_DB_SCHEMAS=public,graphql_public

# -----------------------------------------------------------------------------
# Auth — email sign-in (GoTrue)
# -----------------------------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# Only needed when ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# -----------------------------------------------------------------------------
# Auth — OAuth sign-in (optional)
# Redirect URI for every provider: ${API_EXTERNAL_URL}/auth/v1/callback
# Add that URI in each provider's developer console.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/v1/callback

GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/v1/callback

DISCORD_OAUTH_ENABLED=false
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=http://localhost:8000/auth/v1/callback

# -----------------------------------------------------------------------------
# Object storage (MinIO)
# -----------------------------------------------------------------------------
OBJECT_STORAGE_TYPE=s3
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret-password
S3_BUCKET_NAME=readest-files
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# SELF_HOSTED=true — unlocks all premium features (default for private deployments)
# Set false only when running a hosted service that sells subscriptions.
# -----------------------------------------------------------------------------
SELF_HOSTED=true
STORAGE_FIXED_QUOTA=1073741824
TRANSLATION_FIXED_QUOTA=50000

# Mirror CJK fonts on custom domains (see docker/README.md)
FONT_BASE_URL=

# -----------------------------------------------------------------------------
# AI assistant (/api/ai/chat, /api/ai/embed)
# Vercel AI Gateway: https://vercel.com/docs/ai-gateway
# Users can also supply a personal key in app Settings → AI.
# -----------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
# AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small

# -----------------------------------------------------------------------------
# Translation — DeepL server proxy (/api/deepl/translate)
# Comma-separated keys for rotation. Pro keys used when JWT plan is pro (ignored
# when SELF_HOSTED=true — all users share TRANSLATION_FIXED_QUOTA instead).
# Azure + Yandex translators need no keys (proxied at /api/azure-translate,
# /api/yandex-translate). Google Translate is client-side.
# -----------------------------------------------------------------------------
# DEEPL_FREE_API_KEYS=
# DEEPL_PRO_API_KEYS=
# DEEPL_FREE_API=https://api-free.deepl.com/v2/translate
# DEEPL_PRO_API=https://api.deepl.com/v2/translate
# DEEPL_X_FINGERPRINT=
# YANDEX_UPSTREAM_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Metadata search (/api/metadata/search)
# -----------------------------------------------------------------------------
# GOOGLE_BOOKS_API_KEYS=

# -----------------------------------------------------------------------------
# Google Drive / OneDrive sync (third-party cloud)
# NOT runtime env vars for the stock Docker image — bake at build time.
# Rebuild: docker compose -f docker-compose.yml -f docker/compose.build.yaml up --build -d
# Register SITE_URL as authorized origin on each OAuth client.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# -----------------------------------------------------------------------------
# Billing (unused when SELF_HOSTED=true)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Share uploads (optional public temp bucket)
# -----------------------------------------------------------------------------
# TEMP_STORAGE_PUBLIC_BUCKET_NAME=
